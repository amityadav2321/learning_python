    "square=lambda x:x**2\n",
    "print(square(5))\n",
    "numbers=[1,2,3,4,5,6,7,8]\n",
    "squared=list(map(lambda x:x**2,numbers))\n",
    "print(\"squared\",squared)\n",
    "even=list(filter(lambda x:x%2==0,numbers))\n",
    "print(\"even\",even)"
